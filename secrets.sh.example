# Copy to secrets.sh (git-ignored) and fill in. Sourced by jira-mcp-server.sh at startup.
#
# Jira Cloud:  JIRA_USERNAME = your Atlassian e-mail, JIRA_TOKEN = API token from
#              https://id.atlassian.com/manage-profile/security/api-tokens
# Server / DC: leave JIRA_USERNAME empty and put a Personal Access Token in JIRA_TOKEN
#              (or set both to use username + password basic auth).
export JIRA_URL="https://your-company.atlassian.net"
export JIRA_USERNAME="you@your-company.com"
export JIRA_TOKEN="..."
# Optional: extra fields added to each ticket (ids or display names)
# export JIRA_FIELDS="status,assignee,priority,labels,Story Points"
